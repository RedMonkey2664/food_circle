# Copy to .env.local and fill in. Never commit .env.local.
#
# Local development: run `pnpm db:start`; it prints the local API URL and keys.
# Hosted: Supabase dashboard > Project Settings > API Keys.

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER AND SCRIPTS ONLY. Never prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# Maps (Phase 5). Optional: a MapLibre style URL. Empty = OpenFreeMap liberty (free, OSM-based, no key).
NEXT_PUBLIC_MAP_STYLE_URL=

# Feature flags (all off by default)
GOOGLE_PLACES_ENABLED=false
NEXT_PUBLIC_HANDOFF_SWIGGY_ENABLED=false
NEXT_PUBLIC_HANDOFF_ZOMATO_ENABLED=false
NEXT_PUBLIC_LEADERBOARDS_ENABLED=false

# OSM seed script contact (Overpass etiquette: identify yourself)
OSM_SEED_CONTACT=

# Web push (Phase 7). Generate once with: npx web-push generate-vapid-keys
# Public key is safe to ship; the private key is SERVER ONLY. Leave empty to turn push off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google sign-in brand verification (Search Console HTML tag content only, not the whole tag)
GOOGLE_SITE_VERIFICATION=
# Contact shown on /privacy and /terms
NEXT_PUBLIC_SUPPORT_EMAIL=
